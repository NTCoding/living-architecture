{
  "ignorePatterns": [
    "**/*.spec.ts",
    "**/__fixtures__/**",
    "**/*-fixtures.ts",
    "**/test-fixtures.ts",
    "**/test-fixture-*.ts"
  ],
  "jsPlugins": [
    {
      "name": "riviere-role-enforcement",
      "specifier": "./packages/riviere-role-enforcement/role-enforcement-plugin.mjs"
    }
  ],
  "rules": {
    "riviere-role-enforcement/enforce-roles": [
      "error",
      {
        "configDir": "/Users/nicko/code/living-architecture",
        "configDisplayPath": "role-enforcement.config.ts",
        "layers": {
          "packages/riviere-cli/src/features/{feature}/entrypoint": {
            "allowedRoles": [
              "cli-entrypoint"
            ],
            "paths": [
              "packages/riviere-cli/src/features/*/entrypoint"
            ],
            "forbiddenImports": [
              "**/infra/persistence/**"
            ]
          },
          "packages/riviere-cli/src/features/{feature}/commands": {
            "allowedRoles": [
              "command-use-case",
              "command-use-case-input",
              "command-use-case-result",
              "command-use-case-result-value",
              "command-input-factory"
            ],
            "paths": [
              "packages/riviere-cli/src/features/*/commands"
            ],
            "forbiddenImports": [
              "**/infra/cli/**"
            ]
          },
          "packages/riviere-cli/src/features/{feature}/queries": {
            "allowedRoles": [
              "query-model-use-case",
              "query-model-use-case-input",
              "query-model",
              "query-model-error"
            ],
            "paths": [
              "packages/riviere-cli/src/features/*/queries"
            ],
            "forbiddenImports": [
              "**/infra/cli/**"
            ]
          },
          "packages/riviere-cli/src/features/{feature}/domain": {
            "allowedRoles": [
              "aggregate",
              "value-object",
              "domain-service",
              "domain-error",
              "query-model"
            ],
            "paths": [
              "packages/riviere-cli/src/features/*/domain"
            ]
          },
          "packages/riviere-cli/src/features/{feature}/infra/external-clients/{client}": {
            "allowedRoles": [
              "external-client-service",
              "external-client-model",
              "external-client-error"
            ],
            "paths": [
              "packages/riviere-cli/src/features/*/infra/external-clients/*"
            ]
          },
          "packages/riviere-cli/src/features/{feature}/infra/persistence": {
            "allowedRoles": [
              "aggregate-repository",
              "query-model-loader"
            ],
            "paths": [
              "packages/riviere-cli/src/features/*/infra/persistence"
            ]
          },
          "packages/riviere-cli/src/features/{feature}/infra/cli/output": {
            "allowedRoles": [
              "cli-output-formatter"
            ],
            "paths": [
              "packages/riviere-cli/src/features/*/infra/cli/output"
            ]
          },
          "packages/riviere-cli/src/platform/domain": {
            "allowedRoles": [
              "aggregate",
              "value-object",
              "domain-service",
              "domain-error",
              "query-model"
            ],
            "paths": [
              "packages/riviere-cli/src/platform/domain"
            ]
          },
          "packages/riviere-cli/src/platform/infra/external-clients/{client}": {
            "allowedRoles": [
              "external-client-service",
              "external-client-model",
              "external-client-error"
            ],
            "paths": [
              "packages/riviere-cli/src/platform/infra/external-clients/*"
            ]
          },
          "packages/riviere-cli/src/platform/infra/cli/input": {
            "allowedRoles": [
              "cli-input-validator"
            ],
            "paths": [
              "packages/riviere-cli/src/platform/infra/cli/input"
            ]
          },
          "packages/riviere-cli/src/platform/infra/cli/presentation": {
            "allowedRoles": [
              "cli-output-formatter",
              "cli-error"
            ],
            "paths": [
              "packages/riviere-cli/src/platform/infra/cli/presentation"
            ]
          },
          "packages/riviere-cli/src/shell": {
            "allowedRoles": [
              "main"
            ],
            "paths": [
              "packages/riviere-cli/src/shell"
            ]
          }
        },
        "roleDefinitionsDir": ".riviere/role-definitions",
        "roles": [
          {
            "name": "cli-entrypoint",
            "targets": [
              "function"
            ]
          },
          {
            "name": "command-use-case",
            "targets": [
              "class",
              "function"
            ],
            "allowedInputs": [
              "command-use-case-input"
            ],
            "allowedOutputs": [
              "command-use-case-result"
            ],
            "forbiddenDependencies": [
              "command-use-case"
            ],
            "minPublicMethods": 1,
            "maxPublicMethods": 1
          },
          {
            "name": "command-use-case-input",
            "targets": [
              "interface",
              "type-alias"
            ],
            "nameMatches": ".*Input$"
          },
          {
            "name": "command-use-case-result",
            "targets": [
              "interface",
              "type-alias"
            ],
            "nameMatches": ".*Result$"
          },
          {
            "name": "command-use-case-result-value",
            "targets": [
              "interface",
              "type-alias"
            ]
          },
          {
            "name": "cli-output-formatter",
            "targets": [
              "function"
            ]
          },
          {
            "name": "command-input-factory",
            "targets": [
              "function"
            ],
            "allowedOutputs": [
              "command-use-case-input"
            ]
          },
          {
            "name": "external-client-service",
            "targets": [
              "function"
            ]
          },
          {
            "name": "aggregate-repository",
            "targets": [
              "class"
            ],
            "allowedOutputs": [
              "aggregate",
              "domain-error"
            ],
            "forbiddenDependencies": [
              "aggregate-repository"
            ]
          },
          {
            "name": "aggregate",
            "targets": [
              "interface",
              "type-alias",
              "class"
            ],
            "minPublicMethods": 1,
            "approvedInstances": [
              {
                "name": "ExtractionProject",
                "userHasApproved": true
              },
              {
                "name": "RiviereBuilder",
                "userHasApproved": true
              }
            ]
          },
          {
            "name": "value-object",
            "targets": [
              "interface",
              "type-alias",
              "class"
            ]
          },
          {
            "name": "domain-error",
            "targets": [
              "class"
            ]
          },
          {
            "name": "domain-service",
            "targets": [
              "function",
              "class"
            ]
          },
          {
            "name": "query-model-use-case",
            "targets": [
              "class"
            ],
            "allowedInputs": [
              "query-model-use-case-input"
            ],
            "allowedOutputs": [
              "query-model"
            ],
            "forbiddenDependencies": [
              "query-model-use-case"
            ],
            "minPublicMethods": 1,
            "maxPublicMethods": 1
          },
          {
            "name": "query-model-use-case-input",
            "targets": [
              "interface",
              "type-alias"
            ],
            "nameMatches": ".*(Input|Options)$"
          },
          {
            "name": "query-model",
            "targets": [
              "class",
              "function",
              "interface",
              "type-alias"
            ]
          },
          {
            "name": "query-model-error",
            "targets": [
              "class"
            ]
          },
          {
            "name": "query-model-loader",
            "targets": [
              "class"
            ],
            "allowedOutputs": [
              "query-model",
              "domain-error"
            ],
            "forbiddenDependencies": [
              "query-model-loader"
            ]
          },
          {
            "name": "external-client-model",
            "targets": [
              "interface",
              "type-alias",
              "class"
            ]
          },
          {
            "name": "external-client-error",
            "targets": [
              "class"
            ]
          },
          {
            "name": "cli-input-validator",
            "targets": [
              "function"
            ]
          },
          {
            "name": "cli-error",
            "targets": [
              "class"
            ]
          },
          {
            "name": "main",
            "targets": [
              "function"
            ],
            "forbiddenMethodCalls": [
              "command-use-case",
              "query-model-use-case",
              "aggregate-repository",
              "query-model-loader"
            ]
          }
        ],
        "workspacePackageSources": {
          "@living-architecture/riviere-builder": "packages/riviere-builder/src/index.ts",
          "@living-architecture/riviere-query": "packages/riviere-query/src/index.ts"
        }
      }
    ]
  }
}