{
  "name": "dev-workflow-v2",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:codex-runtime": "esbuild src/shell/codex-cli.ts --bundle --platform=node --format=esm --conditions=@living-architecture/source --outfile=com.openai.codex/dist/codex-cli.mjs && esbuild src/shell/codex-workflow-command.ts --bundle --platform=node --format=esm --conditions=@living-architecture/source --outfile=com.openai.codex/dist/codex-workflow-command.mjs",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@living-architecture/dev-workflow-v2-use-cases": "workspace:*",
    "@nt-ai-lab/deterministic-agent-workflow-claude-code": "0.4.1",
    "@nt-ai-lab/deterministic-agent-workflow-cli": "0.4.1",
    "@nt-ai-lab/deterministic-agent-workflow-codex": "0.4.2",
    "@nt-ai-lab/deterministic-agent-workflow-engine": "0.4.1",
    "@nt-ai-lab/deterministic-agent-workflow-event-store": "0.4.1",
    "@nt-ai-lab/deterministic-agent-workflow-opencode": "0.4.1",
    "tsx": "4.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "esbuild": "^0.27.0",
    "typescript": "npm:typescript@^7.0.2",
    "vitest": "^2.0.0"
  }
}
