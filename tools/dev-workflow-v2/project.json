{
  "name": "dev-workflow-v2",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "pnpm run build",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "dependsOn": ["lint", "^build", "build"]
    }
  }
}
