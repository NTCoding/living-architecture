{
  "name": "dev-workflow-v2",
  "targets": {
    "build-codex-runtime": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build:codex-runtime",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/com.openai.codex/dist"]
    },
    "test": {
      "dependsOn": ["build-codex-runtime"]
    }
  }
}
