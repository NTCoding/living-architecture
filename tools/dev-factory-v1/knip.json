{
  "$schema": "https://knip.dev/reference/knip-json",
  "workspaces": {
    "software-factory/domain-model": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "software-factory/use-cases": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "server": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "ui": {
      "entry": [
        "src/main.tsx"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    }
  },
  "ignore": [
    ".riviere/**",
    "**/node_modules/**",
    "**/*.d.ts",
    "**/dist/**",
    "**/coverage/**",
    "**/test-output/**"
  ],
  "rules": {
    "files": "off",
    "exports": "off",
    "types": "off",
    "dependencies": "off"
  }
}
