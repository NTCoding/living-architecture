{
  "name": "riviere-builder-domain-model",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node ../../../scripts/build-public-exports.mjs . --clean",
          "tsc --build tsconfig.lib.json",
          "node ../../../scripts/build-public-exports.mjs ."
        ],
        "cwd": "{projectRoot}",
        "parallel": false
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "typedoc": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec typedoc --options packages/riviere-builder/domain-model/typedoc.json",
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": ["build"]
    }
  }
}
