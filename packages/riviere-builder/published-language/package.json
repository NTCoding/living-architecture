{
  "name": "@living-architecture/riviere-builder-published-language",
  "description": "Defines the public domain interface for constructing Rivière architecture graphs.",
  "version": "0.16.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NTCoding/living-architecture.git",
    "directory": "packages/riviere-builder/published-language"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@living-architecture/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "@living-architecture/source": "./src/published-language/*.ts",
      "types": "./dist/published-language/*.d.ts",
      "import": "./dist/published-language/*.js",
      "default": "./dist/published-language/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__fixtures__/**",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@living-architecture/riviere-schema-published-language": "workspace:*",
    "zod": "^4.2.1"
  }
}
