{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../riviere-schema/published-language/tsconfig.lib.json"
    },
    {
      "path": "../published-language/tsconfig.lib.json"
    },
    {
      "path": "../domain-model/tsconfig.lib.json"
    }
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts", "src/**/__fixtures__/**"]
}
