{
  "name": "@living-architecture/living-documentation-domain-model",
  "description": "Models source architecture, extracted architecture, and architecture differences for living documentation.",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@living-architecture/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./domain/*": {
      "@living-architecture/source": "./src/domain/*.ts",
      "types": "./dist/domain/*.d.ts",
      "import": "./dist/domain/*.js",
      "default": "./dist/domain/*.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {}
}
