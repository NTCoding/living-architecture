{
  "name": "riviere-extract-conventions-published-language",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node ../../../scripts/build-public-exports.mjs . --clean",
          "tsc --build tsconfig.lib.json",
          "node ../../../scripts/build-public-exports.mjs ."
        ],
        "cwd": "{projectRoot}",
        "parallel": false
      },
      "outputs": ["{projectRoot}/dist"]
    }
  }
}
