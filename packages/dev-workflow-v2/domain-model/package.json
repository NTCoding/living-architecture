{
  "name": "@living-architecture/dev-workflow-v2-domain-model",
  "description": "Models the maintainer delivery workflow, including its states, allowed transitions, recorded events, and pull request decisions.",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./domain/*": {
      "@living-architecture/source": "./src/domain/*.ts",
      "types": "./dist/domain/*.d.ts",
      "import": "./dist/domain/*.js",
      "default": "./dist/domain/*.js"
    }
  },
  "dependencies": {
    "@nt-ai-lab/deterministic-agent-workflow-dsl": "0.4.4",
    "@nt-ai-lab/deterministic-agent-workflow-engine": "0.4.4",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "typescript": "npm:typescript@^7.0.2",
    "vitest": "^2.0.0"
  }
}
