{
  "name": "riviere-extract-ts-domain-model",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node ../../../scripts/build-public-exports.mjs . --clean",
          "tsc --build tsconfig.lib.json",
          "node ../../../scripts/build-public-exports.mjs ."
        ],
        "cwd": "{projectRoot}",
        "parallel": false
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "role-check": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build",
        "riviere-role-enforcement:build",
        "@living-architecture/riviere-role-enforcement-use-cases:build"
      ],
      "options": {
        "command": "pnpm exec tsx apps/cli/src/shell/role-enforcement-bin.ts .riviere/role-enforcement.config.ts --package packages/riviere-extract-ts/domain-model",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
