{
  "name": "@living-architecture/riviere-extract-config-published-language",
  "description": "Defines the public configuration language used to describe how Rivière components and connections are extracted from source code.",
  "version": "0.11.6",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NTCoding/living-architecture.git",
    "directory": "packages/riviere-extract-config/published-language"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@living-architecture/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema.json": "./extraction-config.schema.json"
  },
  "files": [
    "dist",
    "!dist/**/__fixtures__/**",
    "extraction-config.schema.json",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@living-architecture/riviere-schema-published-language": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "safe-regex2": "^5.1.1",
    "zod": "^4.2.1"
  }
}
