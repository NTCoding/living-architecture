{
  "name": "riviere-extract-config-published-language",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node ../../../scripts/build-public-exports.mjs . --clean",
          "tsc --build tsconfig.lib.json",
          "node ../../../scripts/build-public-exports.mjs ."
        ],
        "cwd": "{projectRoot}",
        "parallel": false
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "generate-docs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec npx tsx packages/riviere-extract-config/published-language/scripts/generate-docs.ts",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{projectRoot}/docs/generated"]
    },
    "check-generated-docs": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm exec npx tsx packages/riviere-extract-config/published-language/scripts/generate-docs.ts",
          "git diff --exit-code packages/riviere-extract-config/published-language/docs/generated/ || (echo 'Generated docs are stale. Run: pnpm nx generate-docs riviere-extract-config' && exit 1)"
        ],
        "cwd": "{workspaceRoot}",
        "parallel": false
      }
    }
  }
}
