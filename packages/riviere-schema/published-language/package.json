{
  "name": "@living-architecture/riviere-schema-published-language",
  "version": "0.12.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NTCoding/living-architecture.git",
    "directory": "packages/riviere-schema/published-language"
  },
  "main": "./dist/published-language/schema.js",
  "module": "./dist/published-language/schema.js",
  "types": "./dist/published-language/schema.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@living-architecture/source": "./src/published-language/schema.ts",
      "types": "./dist/published-language/schema.d.ts",
      "import": "./dist/published-language/schema.js",
      "default": "./dist/published-language/schema.js"
    },
    "./schema": {
      "@living-architecture/source": "./src/published-language/schema.ts",
      "types": "./dist/published-language/schema.d.ts",
      "import": "./dist/published-language/schema.js",
      "default": "./dist/published-language/schema.js"
    },
    "./validation": {
      "@living-architecture/source": "./src/published-language/validation.ts",
      "types": "./dist/published-language/validation.d.ts",
      "import": "./dist/published-language/validation.js",
      "default": "./dist/published-language/validation.js"
    },
    "./graph-validation": {
      "@living-architecture/source": "./src/published-language/graph-validation.ts",
      "types": "./dist/published-language/graph-validation.d.ts",
      "import": "./dist/published-language/graph-validation.js",
      "default": "./dist/published-language/graph-validation.js"
    },
    "./component-id": {
      "@living-architecture/source": "./src/published-language/component-id.ts",
      "types": "./dist/published-language/component-id.d.ts",
      "import": "./dist/published-language/component-id.js",
      "default": "./dist/published-language/component-id.js"
    },
    "./custom-property-type": {
      "@living-architecture/source": "./src/published-language/custom-property-type.ts",
      "types": "./dist/published-language/custom-property-type.d.ts",
      "import": "./dist/published-language/custom-property-type.js",
      "default": "./dist/published-language/custom-property-type.js"
    },
    "./link-id": {
      "@living-architecture/source": "./src/published-language/link-id.ts",
      "types": "./dist/published-language/link-id.d.ts",
      "import": "./dist/published-language/link-id.js",
      "default": "./dist/published-language/link-id.js"
    },
    "./schema.json": "./riviere.schema.json"
  },
  "files": [
    "dist",
    "!dist/**/__fixtures__/**",
    "riviere.schema.json",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
