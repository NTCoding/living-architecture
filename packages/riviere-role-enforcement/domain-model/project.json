{
  "name": "riviere-role-enforcement-domain-model",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run && vitest run --config vitest.plugin.config.mts",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node esbuild.config.mjs",
          "tsc -p tsconfig.lib.json --emitDeclarationOnly --declaration --declarationDir dist"
        ],
        "cwd": "{projectRoot}",
        "parallel": false
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "smoke-test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node -e \"import('./dist/index.js').then(m => { if (!m.RoleEnforcementConfiguration) process.exit(1) })\""
        ],
        "cwd": "{projectRoot}",
        "parallel": false
      },
      "dependsOn": ["build"]
    }
  }
}
