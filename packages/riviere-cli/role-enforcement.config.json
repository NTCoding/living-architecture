{
  "include": ["src/features/extract/**/*.ts", "src/platform/infra/git/**/*.ts"],
  "ignorePatterns": ["**/*.spec.ts", "**/__fixtures__/**"],
  "roles": [
    {
      "name": "cli-entrypoint",
      "targets": ["function"],
      "allowedLocation": ["src/**/entrypoint/*.ts"]
    },
    {
      "name": "command-use-case",
      "targets": ["function"],
      "allowedLocation": ["src/**/commands/*.ts"],
      "allowedInputs": ["command-use-case-input"],
      "allowedOutputs": ["command-use-case-result"]
    },
    {
      "name": "command-use-case-input",
      "targets": ["interface", "type-alias"],
      "allowedLocation": ["src/**/commands/*.ts"],
      "nameMatches": ".*Input$"
    },
    {
      "name": "command-use-case-result",
      "targets": ["interface", "type-alias"],
      "allowedLocation": ["src/**/commands/*.ts"],
      "nameMatches": ".*Result$"
    },
    {
      "name": "cli-output-formatter",
      "targets": ["function"],
      "allowedLocation": ["src/**/infra/cli/output/*.ts"]
    },
    {
      "name": "command-input-factory",
      "targets": ["function"],
      "allowedLocation": ["src/**/commands/*.ts"]
    },
    {
      "name": "external-client-service",
      "targets": ["function"],
      "allowedLocation": ["src/**/infra/external-clients/*.ts", "src/platform/infra/git/*.ts"]
    },
    {
      "name": "aggregate-repository",
      "targets": ["class"],
      "allowedLocation": ["src/**/infra/persistence/**/*.ts"]
    },
    {
      "name": "aggregate",
      "targets": ["interface", "type-alias", "class"],
      "allowedLocation": ["src/**/domain/*.ts"]
    },
    {
      "name": "value-object",
      "targets": ["interface", "type-alias", "class"],
      "allowedLocation": ["src/**/domain/*.ts"]
    },
    {
      "name": "domain-service",
      "targets": ["function"],
      "allowedLocation": ["src/**/domain/*.ts"]
    },
    {
      "name": "external-client-model",
      "targets": ["interface", "type-alias", "class"],
      "allowedLocation": ["src/platform/infra/git/*.ts"]
    },
    {
      "name": "external-client-error",
      "targets": ["class"],
      "allowedLocation": ["src/platform/infra/git/*.ts"]
    }
  ]
}
