{
  "name": "@living-architecture/dev-workflow-v3-use-cases",
  "description": "Commands, queries, ports and adapters that carry a GitHub issue through the software factory workflow to a pull request ready for a person.",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@living-architecture/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./commands/*": {
      "@living-architecture/source": "./src/features/implementation/commands/*.ts",
      "types": "./dist/features/implementation/commands/*.d.ts",
      "import": "./dist/features/implementation/commands/*.js",
      "default": "./dist/features/implementation/commands/*.js"
    },
    "./queries/*": {
      "@living-architecture/source": "./src/features/implementation/queries/*.ts",
      "types": "./dist/features/implementation/queries/*.d.ts",
      "import": "./dist/features/implementation/queries/*.js",
      "default": "./dist/features/implementation/queries/*.js"
    },
    "./adapters/*": {
      "@living-architecture/source": "./src/features/implementation/adapters/*.ts",
      "types": "./dist/features/implementation/adapters/*.d.ts",
      "import": "./dist/features/implementation/adapters/*.js",
      "default": "./dist/features/implementation/adapters/*.js"
    },
    "./external-clients/*": {
      "@living-architecture/source": "./src/infra/external-clients/*.ts",
      "types": "./dist/infra/external-clients/*.d.ts",
      "import": "./dist/infra/external-clients/*.js",
      "default": "./dist/infra/external-clients/*.js"
    }
  },
  "dependencies": {
    "@living-architecture/dev-workflow-v3-domain-model": "workspace:*",
    "@mastra/core": "1.75.0",
    "zod": "^3.23.0"
  }
}
