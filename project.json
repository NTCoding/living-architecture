{
  "name": "@living-architecture/source",
  "targets": {
    "lint-md": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm lint:md",
        "cwd": "{workspaceRoot}"
      }
    },
    "depcruise-eclair": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm depcruise:eclair",
        "cwd": "{workspaceRoot}"
      }
    },
    "knip": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm knip",
        "cwd": "{workspaceRoot}"
      }
    },
    "role-check": {
      "executor": "nx:run-commands",
      "options": {
          "command": "pnpm exec tsx apps/cli/src/shell/role-enforcement-bin.ts .riviere/role-enforcement.config.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
